// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "git": {
    "file_diff": {
      "show_full_file": false,
    },
    "inline_blame": {
      "enabled": false,
    },
    "enable_diff": false,
    "enable_status": true,
    "disable_git": false,
  },
  "cli_default_open_behavior": "new_window",
  "diff_view_style": "split",
  "disable_ai": false,
  "project_panel": {
    "dock": "left",
  },
  "outline_panel": {
    "dock": "left",
  },
  "collaboration_panel": {
    "button": false,
    "dock": "left",
  },
  "git_panel": {
    "tree_view": false,
    "group_by": "staging",
    // "entry_primary_click_action": "view_file",
    "dock": "left",
  },
  "agent_servers": {},
  "vim": {
    "toggle_relative_line_numbers": true,
  },
  "relative_line_numbers": "disabled",
  "agent": {
    "default_profile": "ask",
    "threads_sidebar": {
      "auto_open": true,
    },
    "dock": "right",
    "default_model": {
      "effort": "high",
      "provider": "x_ai",
      "model": "grok-4.7",
      "enable_thinking": true,
    },
    "favorite_models": [],
    "model_parameters": [],
  },
  "vim_mode": true,
  "icon_theme": {
    "mode": "dark",
    "light": "Zed (Default)",
    "dark": "Material Icon Theme",
  },
  "base_keymap": "VSCode",
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Catppuccin Mocha",
  },
  "theme_overrides": {
    "Catppuccin Macchiato": {
      "syntax": {
        "variable": {
          "color": "#f5bde6",
        },
      },
    },
  },
  "terminal": {
    "font_family": "Hack Nerd Font Mono",
    "font_fallbacks": ["Symbols Nerd Font Mono"],
    "font_size": 14,
  },
  "languages": {
    "TypeScript": {
      "language_servers": ["!vtsls", "..."],
    },
    "TSX": {
      "language_servers": ["!vtsls", "..."],
    },
    "JavaScript": {
      "language_servers": ["!vtsls", "..."],
    },
  },
  "file_scan_exclusions": [
    "**/.git",
    "**/node_modules",
    "**/dist",
    "**/.nx",
    "**/.worktrees",
    "**/storybook-static",
    "**/coverage",
  ],
}
